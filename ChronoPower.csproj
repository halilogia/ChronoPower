<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>ChronoPower</AssemblyName>
    <RootNamespace>ChronoPower</RootNamespace>
    <ApplicationTitle>ChronoPower</ApplicationTitle>
    <ApplicationIcon>ChronoPower.ico</ApplicationIcon>
    <Product>ChronoPower Smart Power Scheduler</Product>
    <Description>Modern, planlı bilgisayar kapatma, uyku ve güç yönetimi asistanı</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
